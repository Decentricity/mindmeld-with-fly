#!/usr/bin/env bash
# Living MaleCNS viz — same tmux-safe libcaca policy as mplay-caca.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ROOT="${MINDMELD_ROOT:-$ROOT}"
PY="${ROOT}/.venv/bin/python"

if [[ -n "${TMUX:-}" ]]; then
  export CACA_DRIVER="${CACA_DRIVER:-slang}"
else
  export CACA_DRIVER="${CACA_DRIVER:-ncurses}"
fi

case "${TERM:-}" in
  tmux*|screen*) ;;
  *) export TERM="${TERM:-xterm-256color}" ;;
esac

if [[ -n "${TMUX:-}" ]] && command -v tmux >/dev/null 2>&1; then
  tmux set-option -p alternate-screen off >/dev/null 2>&1 || true
fi

if [[ ! -x "$PY" ]]; then
  # fall back to connectome venv on this machine until ./install.sh
  if [[ -x /home/decentricity/connectome/.venv/bin/python ]]; then
    PY=/home/decentricity/connectome/.venv/bin/python
  else
    printf '%s\n' "living-caca: missing venv python at $ROOT/.venv" >&2
    exit 1
  fi
fi

cd "$ROOT"
# Prefer this tree's package; symlink data from connectome if needed locally
export PYTHONPATH="${ROOT}${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m mindmeld.living --renderer caca "$@"
